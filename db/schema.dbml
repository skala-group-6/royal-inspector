Table "tenants" {
  "tenant_id" int [pk, increment]
  "name" text [unique, not null]
  "created_at" timestamptz [not null, default: `now()`]
  Note: '[cfg] 회사(테넌트). 모든 표의 뿌리.'
}

Table "reviewers" {
  "tenant_id" int [not null]
  "reviewer_id" int [increment]
  "name" text [not null]
  "role" text [not null, check: `role in ('reviewer','admin','dev')`, default: 'reviewer']
  "counts_as_label" boolean [not null, default: true, note: '학습 라벨로 쓸지. 개발팀 테스트 계정은 false.']
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    (tenant_id, reviewer_id) [pk]
    (tenant_id, name) [unique]
  }
}

Table "data_sources" {
  "tenant_id" int [not null]
  "source_id" int [increment]
  "kind" text [not null, check: `kind in ('card_tx','hr','access','policy')`]
  "name" text [not null]
  "column_mapping" jsonb [not null, default: `'{}'::jsonb`]
  "raw_glob" text
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    (tenant_id, source_id) [pk]
  }
  Note: '[cfg] 회사별 입력 파일과 열 매핑.'
}

Table "rule_settings" {
  "tenant_id" int [not null]
  "rule_id" text [not null]
  "version" int [not null]
  "enabled" boolean [not null, default: true]
  "params" jsonb [not null, default: `'{}'::jsonb`]
  "policy_ref" text
  "changed_by" text [not null]
  "changed_at" timestamptz [not null, default: `now()`]
  "note" text

  Indexes {
    (tenant_id, rule_id, version) [pk]
  }
  Note: '[cfg] 공통 규칙 카탈로그 위 회사별 덮어쓰기. 변경마다 새 version 행.'
}

Table "account_map" {
  "tenant_id" int [not null]
  "account_raw" text [not null]
  "account_policy" text
  "method" text

  Indexes {
    (tenant_id, account_raw) [pk]
  }
  Note: '[cfg] 원장 계정명 → 규정 계정명 매핑 (적재가 생성, 수동 결정 포함).'
}

Table "loads" {
  "tenant_id" int [not null]
  "load_id" int [increment]
  "source_id" int
  "file_name" text
  "file_hash" text [not null]
  "n_rows" int
  "status" text [not null, check: `status in ('running','done','failed')`, default: 'done']
  "loaded_at" timestamptz [not null, default: `now()`]

  Indexes {
    (tenant_id, load_id) [pk]
  }
}

